# =================================================================
# Configurações do Ambiente de Produção - e-Cidadão Suite
# =================================================================

# -----------------------------------------------------------------
# 1. Cloudflare Zero Trust Tunnel
# Obtenha o token no painel Cloudflare Zero Trust > Networks > Tunnels
# -----------------------------------------------------------------
CLOUDFLARE_TUNNEL_TOKEN=seu_token_do_cloudflare_tunnel_aqui

# -----------------------------------------------------------------
# 2. URLs Públicas de Domínio (Configuradas no Cloudflare)
# -----------------------------------------------------------------
# URL pública onde a API estará acessível
API_URL=https://api.cidadao.arcoverde.pe.gov.br
NEXT_PUBLIC_API_URL=https://api.cidadao.arcoverde.pe.gov.br

# Origens permitidas para CORS (separadas por vírgula)
CORS_ORIGIN=https://cidadao.arcoverde.pe.gov.br,https://painel.cidadao.arcoverde.pe.gov.br

# -----------------------------------------------------------------
# 3. Banco de Dados PostgreSQL
# -----------------------------------------------------------------
DB_USER=postgres
DB_PASSWORD=sua_senha_forte_do_postgres_em_producao
DB_NAME=ecidadao_db
DB_SYNCHRONIZE=false
DB_LOGGING=false

# -----------------------------------------------------------------
# 4. Redis Cache e Filas
# -----------------------------------------------------------------
REDIS_PASSWORD=

# -----------------------------------------------------------------
# 5. Segurança & JWT
# -----------------------------------------------------------------
JWT_SECRET=gere_uma_chave_jwt_hexadecimal_aleatoria_super_segura_32_chars
COOKIE_SECRET=gere_uma_chave_cookie_hexadecimal_aleatoria_super_segura_32_chars
